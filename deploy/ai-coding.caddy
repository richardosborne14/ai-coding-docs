# ai-coding.digitalbricks.io — static VitePress build.
# Installed to /etc/caddy/conf.d/ai-coding.caddy by deploy/deploy.sh --go-live.
ai-coding.digitalbricks.io {
	root * /srv/ai-coding/site
	encode zstd gzip

	# VitePress builds with cleanUrls: /part-1/philosophy -> part-1/philosophy.html
	try_files {path} {path}.html {path}/index.html
	file_server

	handle_errors 404 {
		rewrite * /404.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	# Hashed build output never changes under the same name.
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	header /brand/* Cache-Control "public, max-age=604800"
}
